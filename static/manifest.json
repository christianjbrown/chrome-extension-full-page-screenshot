{
  "manifest_version": 3,
  "name": "Christian's Full Page Screenshot",
  "version": "1.0.4",
  "description": "One click saves a screenshot of the whole page, top to bottom, as a PNG in your downloads folder.",
  "minimum_chrome_version": "126",
  "permissions": [
    "activeTab",
    "scripting",
    "offscreen",
    "downloads",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Screenshot this whole page",
    "default_icon": {
      "16": "icons/on-dark/icon-16.png",
      "32": "icons/on-dark/icon-32.png",
      "48": "icons/on-dark/icon-48.png",
      "128": "icons/on-dark/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/on-dark/icon-16.png",
    "32": "icons/on-dark/icon-32.png",
    "48": "icons/on-dark/icon-48.png",
    "128": "icons/on-dark/icon-128.png"
  }
}
